{% import "macros/mediawiki.j2" as mw %}
{% extends "components/list_item.j2" %}

{% block title %}
<div class="wiki-list-item-title">
    {{ mw.parameter("title") }}
</div>
{% endblock %}

{% block meta %}
<div class="wiki-list-item-meta">
    {{ mw.parameter("meta") }}
</div>
{% endblock %}

{% block content %}
<div class="wiki-list-item-content">
    {{ mw.parameter("content") }}
</div>
{% endblock %}
